tag:
  - logical_reasoning
  - multiple_choice
custom_dataset: !function utils.load_dataset
output_type: multiple_choice
test_split: test
num_fewshot: 0
doc_to_text: "{{theory}}\nQuestion: {{question}}\nAnswer:"
doc_to_target: label
doc_to_choice:
  - "true"
  - "false"
target_delimiter: " "
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
  dataset_version: V2020.2.5
