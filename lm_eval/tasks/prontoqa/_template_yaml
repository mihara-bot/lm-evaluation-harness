tag:
  - logical_reasoning
custom_dataset: !function utils.load_dataset
output_type: generate_until
test_split: test
doc_to_text: !function utils.doc_to_text
doc_to_target: !function utils.doc_to_target
target_delimiter: ""
process_results: !function utils.process_results
generation_kwargs:
  until:
    - "\n\nQ:"
    - "\n\n"
    - "</s>"
    - "<|im_end|>"
  max_gen_toks: 512
  do_sample: false
  temperature: 0.0
metric_list:
  - metric: final_statement_match
    aggregation: mean
    higher_is_better: true
  - metric: proof_exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
