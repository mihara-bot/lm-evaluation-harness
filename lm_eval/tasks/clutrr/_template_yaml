tag:
  - logical_reasoning
  - multiple_choice
custom_dataset: !function utils.load_dataset
dataset_kwargs:
  task: gen_train234_test2to10
output_type: multiple_choice
training_split: train
fewshot_split: train
validation_split: validation
test_split: test
doc_to_text: "Story:\n{{story.strip()}}\n\nQuestion: How is {{query_person2}} related to {{query_person1}}?\nAnswer:"
doc_to_target: label
doc_to_choice: choices
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: acc_norm
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
